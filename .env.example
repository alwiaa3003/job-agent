# Copy this file to .env and put your real key in .env (never in this file).
#   cp .env.example .env

# Which provider we talk to (any OpenAI-compatible API works)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1

# Main model, and a second model used for comparison in the evaluation
LLM_MODEL=openai/gpt-oss-120b
LLM_COMPARE_MODEL=openai/gpt-oss-20b

# gpt-oss models "think" before answering. low = less thinking, fewer tokens used
LLM_REASONING_EFFORT=low

# Memory: SQLite file for saved jobs + preferences (gitignored, *.db)
JOBAGENT_DB=data/jobagent.db
# Max estimated tokens of conversation history sent per request
HISTORY_TOKEN_BUDGET=2500

# Where jobs come from: local_csv (fixed LinkedIn data, default) or live
# (current remote jobs from the free Himalayas API, no key needed)
JOB_SOURCE=local_csv
# 1 = live source uses ONLY saved responses in cache/himalayas/ (no network)
LIVE_OFFLINE=0

# NAME of the environment variable that holds the key (not the key itself)
LLM_API_KEY_VAR=GROQ_API_KEY

# Your key goes here in .env. Get one free at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here
